# =====================================================================
# EEMT 2027 - Environment Configuration
# Works identically on:
#   1. Local Development (PHP built-in server, Laragon, XAMPP)
#   2. Shared Hosting (cPanel, Hostinger, GoDaddy, Bluehost, etc.)
#   3. VPS (Ubuntu, Debian, AlmaLinux, Nginx / Apache / Docker)
# =====================================================================

APP_ENV=production
APP_DEBUG=false
APP_NAME="EEMT 2027"
APP_URL=http://localhost:8000

# =====================================================================
# Database Driver Selection:
#   - 'mysql'  : Recommended for Shared Hosting (cPanel MySQL) & VPS MariaDB/MySQL
#   - 'sqlite' : Zero-configuration file database (works out-of-the-box)
# =====================================================================
DB_DRIVER=sqlite

# MySQL / MariaDB Configuration (Used when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ducatio9_eemt2027
DB_USERNAME=ducatio9_registration
DB_PASSWORD=Rao969699

# SQLite Configuration (Used when DB_DRIVER=sqlite)
DB_SQLITE_PATH=database/eemt2027.sqlite

# Mailer Settings
MAIL_FROM_EMAIL=no-reply@educationalepiphany.org
MAIL_FROM_NAME="EEMT 2027"
MAIL_REPLY_TO=support@educationalepiphany.org
